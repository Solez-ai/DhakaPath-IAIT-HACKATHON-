# Copy to .env and fill in your own keys:  cp .env.example .env
#
# The Gemini key is used by server.mjs only — it is never sent to the browser.
# The CARTO key is public by design: the browser needs it to load basemap tiles.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary model plus optional fallbacks (tried in order on 404 / 429 / 503).
# Useful ids: gemini-3.8-flash, gemini-flash-latest, gemini-3.7-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash

# "low" keeps thinking-token spend down (faster, no truncated short answers).
# Leave empty for models without thinking support.
GEMINI_THINKING_LEVEL=low
# Thinking tokens count against this budget — too small truncates replies.
GEMINI_MAX_OUTPUT_TOKENS=2048
# Per-attempt timeout in ms (non-streaming requests).
GEMINI_TIMEOUT_MS=45000
# Whole-stream safety net in ms.
GEMINI_STREAM_TIMEOUT_MS=180000

# Upstream API base. Override to route through a gateway, or point the chat at a
# local mock while testing without spending quota.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# CARTO Basemaps key: https://carto.com/basemaps/apikey
# Raster tiles: https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=YOUR_KEY
CARTO_API_KEY=

# Dev server port
PORT=8000
